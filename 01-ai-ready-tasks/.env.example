# .env.example

# LINEAR_API_KEY is used to authenticate requests to the Linear API.
# You can obtain this key from your Linear account settings.
LINEAR_API_KEY=your_linear_api_key_here

# OPENAI_API_KEY is required to access OpenAI's API services.
# You can generate this key from your OpenAI account dashboard.
OPENAI_API_KEY=your_openai_api_key_heres